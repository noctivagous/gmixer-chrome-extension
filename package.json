{
  "name": "gmixer-chrome-extension",
  "version": "0.1.0",
  "description": "gMixer — re-theme any web page (colors, fonts, image filters, corner clipping, effects) for Opera GX.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "build:debug": "node build.js --debug",
    "build:minify": "node build.js --minify",
    "watch": "node build.js --watch",
    "watch:debug": "node build.js --watch --debug",
    "fonts:fetch": "node scripts/fetch-wiegel-fonts.mjs",
    "fonts:google": "node scripts/fetch-google-fonts.mjs",
    "fonts:reclassify": "node scripts/reclassify-fonts.mjs",
    "lint": "eslint src test build.js scripts",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@webcomponents/custom-elements": "^1.6.0",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.24.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0"
  }
}
